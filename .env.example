# =====================================================================
# НАСТРОЙКИ СТЕКА: OmniRoute + Laya + Google Drive Backup
# Скопируйте этот файл в .env и скорректируйте параметры под свои нужды:
# cp .env.example .env
# =====================================================================

# ---------------------------------------------------------------------
# Общие настройки
# ---------------------------------------------------------------------
# Часовой пояс для планировщика бэкапов и логов
TZ=Europe/Moscow

# Адрес привязки портов на хосте:
# 127.0.0.1 - доступ только локально с этого компьютера (безопасно)
# 0.0.0.0   - доступ со всей локальной сети / внешнего IP
HOST_BIND_IP=127.0.0.1

# Рабочая директория проектов на хосте
WORKSPACE_DIR=./workspace

# ---------------------------------------------------------------------
# OmniRoute (AI API Gateway & Router)
# ---------------------------------------------------------------------
# Порты OmniRoute
OMNIROUTE_DASHBOARD_PORT=20128
OMNIROUTE_API_PORT=20129
OMNIROUTE_LIVE_WS_PORT=20132

# Авторизация OmniRoute:
# false - доступ к дашборду и API открыт (подходит при HOST_BIND_IP=127.0.0.1)
# true  - требуется пароль дашборда и API ключ
REQUIRE_API_KEY=false
# Задайте пароль для входа в панель OmniRoute (если пусто, сгенерируется в логах)
INITIAL_PASSWORD=

# Ограничение памяти для Node.js OmniRoute (в мегабайтах)
OMNIROUTE_MEMORY_MB=2048

# ---------------------------------------------------------------------
# Laya (System 1 Decision Engine на базе форка ggmlc)
# ---------------------------------------------------------------------
# Порт веб-интерфейса и API Laya
LAYA_PORT=8080

# Устройство инференса (cuda, cpu, auto)
LAYA_DEVICE=cuda

# Дополнительные флаги запуска (--cuda-graph для аппаратного ускорения CUDA, --threads 8 для CPU)
LAYA_EXTRA_FLAGS=--cuda-graph

# ---------------------------------------------------------------------
# Резервное копирование на Google Диск (rclone)
# ---------------------------------------------------------------------
# Имя remote из rclone.conf (по умолчанию 'gdrive')
RCLONE_REMOTE=gdrive

# Папка на Google Диске, куда складывать архивы
RCLONE_DEST_FOLDER=backups/deepseek-stack

# Сколько дней хранить бэкапы на Google Диске (автоматическое удаление старых)
RETENTION_DAYS=14

# Гарантированный минимум копий (не удалять, если осталось <= N копий, даже если старше RETENTION_DAYS)
MIN_BACKUPS_TO_KEEP=3

# Расписание создания бэкапов (формат CRON)
# 0 3 * * * = каждый день в 03:00 ночи
BACKUP_CRON_SCHEDULE=0 3 * * *

# Делать ли бэкап сразу при старте контейнера (true / false)
BACKUP_ON_STARTUP=false

# ---------------------------------------------------------------------
# Пути к каталогам нативного стека Harness для контейнера бэкапа
# ---------------------------------------------------------------------
HERMES_DIR=/root/.hermes/hermes-agent/
DSH_DIR=/root/harness/dsh

# ---------------------------------------------------------------------
# Веб-редактор VS Code (code-server)
# ---------------------------------------------------------------------
# Порт для доступа к веб-интерфейсу VS Code в браузере
VSCODE_PORT=8443

# Метод авторизации: 'none' (без пароля) или 'password' (требуется пароль)
VSCODE_AUTH=none

# Пароль для входа (если VSCODE_AUTH=password)
VSCODE_PASSWORD=

# Включить HTTPS с самоподписанным сертификатом (true / пусто) для устранения предупреждения об insecure context
VSCODE_CERT=
