# ==============================================================================
# Пример конфигурации .env для Qwen3.8-27B EfficientThink-K3-MTP-NVFP4
# ==============================================================================

HOST_BIND_IP=0.0.0.0
K3_PORT=8087
TARGET_GPU_UUID=GPU-733ae7cc-c1bf-3352-42d5-ba2762470325
K3_MODELS_DIR=/root/model/efficientthink_k3
K3_MODEL_FILE=model_v100.ninfer
K3_ALIAS=efficientthink-k3-27b
K3_API_KEY=

K3_MAX_CONTEXT=235520
K3_KV_CAPACITY=235520
K3_MAX_CONCURRENCY=1
K3_KV_DTYPE=int8
K3_PREFILL_CHUNK=2048

K3_DEVICE_STATE_SLOTS=1
K3_HOST_STATE_SLOTS=8
K3_HOST_KV_MIB=8192
K3_PENDING_TIMEOUT_MS=1200000

K3_SPEC_BACKEND=mtp
K3_SPEC_DRAFT_TOKENS=3

K3_ENABLE_THINKING=true
K3_PRESERVE_THINKING=true
K3_REASONING_EFFORT=xhigh

K3_ENABLE_VISION=true
K3_MEDIA_CACHE_MIB=512
K3_MEDIA_LIVE_MIB=1024
K3_MEDIA_PREPROCESS_THREADS=4
K3_EXTRA_ARGS=
