# ==============================================================================
# Переменные окружения для запуска DavidAU Qwen3.8-27B-TURBO-Fable-Cold-Fusion
# Специализированная конфигурация под NVIDIA Tesla V100 32GB (sm_70)
# Конфигурация: MTP-Q6_K + KV-кэш Q8_0 на МАКСИМАЛЬНЫЙ контекст 205 000 токенов
#
# Скопируйте в .env или используйте напрямую с docker compose:
#   cp .env.fable.example .env.fable
#   docker compose --env-file .env.fable -f docker-compose.fable.yml up -d
# ==============================================================================

# Привязка адреса хоста (0.0.0.0 для локальной сети LAN, 127.0.0.1 для локального доступа)
HOST_BIND_IP=0.0.0.0

# Порт сервиса на хосте (8083 чтобы не конфликтовать с Laya 8080, Qwen 8081, Bonsai 8082, Coder390 8084)
FABLE_PORT=8083

# Идентификатор GPU для изоляции (Tesla V100 32GB) во избежание сбоя CUDA Forward Compatibility
TARGET_GPU_UUID=GPU-733ae7cc-c1bf-3352-42d5-ba2762470325

# Путь к директории с моделью на хосте
FABLE_MODELS_DIR=/root/model/fable_cold_fusion

# Основной файл модели: Наилучший возможный квант с MTP на 32GB VRAM — Q6_K (~22.38 GiB / 24.03 GB)
# Репозиторий: DavidAU/Qwen3.8-27B-TURBO-Fable-Cold-Fusion-735-882-Heretic-Uncensored-NEO-CODER-MAX-MTP-GGUF
# Обоснование выбора:
#   - Q8_0 MTP весит 28.16 GiB; вместе с оверхедом рантайма (1.75 GiB) базовый вес составляет 29.91 GiB,
#     что оставляет всего 1.69 GiB (до 52K токенов) и при 120K токенов гарантированно вызывает OOM.
#   - Q6_K MTP весит 22.38 GiB (6.56 BPW, сохраняет 99.8% качества FP16).
#     Вместе с KV-кэшем Q8_0 на 205 000 токенов (6.65 GiB) и оверхедом рантайма (1.75 GiB) суммарный расход VRAM
#     составляет 30.78 GiB из 31.60 GiB доступных, оставляя минимально необходимый защитный буфер ~0.82 GiB (~840 MiB) до OOM!
FABLE_MODEL_FILE=Qwen3.8-27B-TurboFCFusion-735-882-Here-Uncen-NEO-CODER-MAX-MTP-Q6_K.gguf

# Мультимодальный проектор зрения (Vision Projector mmproj)
# Файл: mmproj-BF16.gguf (~931 MB)
# FABLE_NO_MMPROJ_OFFLOAD=true: выгружает проектор зрения в оперативную память хоста (CPU RAM),
# сохраняя ~1.5–2.0 ГБ видеопамяти V100 для максимального контекста без риска OOM.
FABLE_MMPROJ_FILE=mmproj-BF16.gguf
FABLE_NO_MMPROJ_OFFLOAD=true
FABLE_CPU_THREADS=16

# Спекулятивное ускорение MTP (Multi-Token Prediction)
# В данной модели MTP-голова интегрирована непосредственно в GGUF-файл весов
FABLE_ENABLE_MTP=true
FABLE_SPEC_DRAFT_N_MAX=3

# Режим рассуждений модели (thinking mode)
# "xhigh"
# 'medium'
# 'low'
# Архитектура TURBO аппаратно сжимает цепочки размышлений в 2-10 раз (в среднем на 65%),
# быстро переходя к содержательному ответу без потери логики.
FABLE_ENABLE_THINKING=true
FABLE_REASONING_EFFORT=xhigh

# Настройки контекста и GPU вычислений для 32GB VRAM с KV-кэшем Q8_0:
# Расчет расхода памяти для KV-кэша Q8_0 (34.0 KiB на токен в 16 слоях внимания):
#   205 000 токенов: KV-кэш = 6.65 GiB (7 137 280 000 байт)
#   Базовый вес модели Q6_K MTP = 22.38 GiB
#   CUDA + DeltaNet SSM + scratch-буферы графа = 1.75 GiB
#   Итого занято VRAM: 22.38 + 1.75 + 6.65 = 30.78 GiB
#   Минимальный защитный буфер до физического OOM (31.60 GiB): +0.82 GiB (~840 MiB)
FABLE_CTX_SIZE=190000
FABLE_N_GPU_LAYERS=999
FABLE_BATCH_SIZE=4096
FABLE_UBATCH_SIZE=1024

# Формат KV-кэша:
#   q8_0  — 8-битный квантованный кэш (34 KiB на токен). Обеспечивает точность без искажений внимания
#           и экономит ~50% VRAM по сравнению с FP16, позволяя контекст до 205 000 токенов на Q6_K.
FABLE_CACHE_K=q8_0
FABLE_CACHE_V=q8_0

# Сэмплирование (для Fable Cold Fusion / Heretic Uncensored):
# Рекомендуется температура 0.8–0.9 для живого и глубокого языка, top-p 0.95, top-k 20, min-p 0.05.
# ВНИМАНИЕ: При использовании MTP параметр repeat_penalty должен быть строго 1.0!
FABLE_TEMP=0.85
FABLE_TOP_P=0.95
FABLE_TOP_K=20
FABLE_MIN_P=0.05
FABLE_REPEAT_PENALTY=1.0

# Авторизация и имена модели для вызовов OpenAI API
FABLE_API_KEY=
FABLE_ALIAS=fable-cold-fusion-27b

# Дополнительные системные аргументы (--load-mode auto --slots)
FABLE_EXTRA_ARGS=--load-mode auto --slots
