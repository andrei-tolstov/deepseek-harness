# ==============================================================================
# Переменные окружения для запуска nerkyor Qwen3.8-27B-Coder390 (NInfer V2)
# Специализированная конфигурация под NVIDIA Tesla V100 32GB (sm_70, CUDA 12.8)
# ==============================================================================

# Привязка адреса хоста (0.0.0.0 для локальной сети LAN)
HOST_BIND_IP=0.0.0.0

# Порт сервиса на хосте (8084)
CODER390_PORT=8084

# Идентификатор GPU для изоляции (Tesla V100 32GB)
# КРИТИЧЕСКИ ВАЖНО: Pascal GTX 1060 не должна быть доступна контейнеру,
# иначе CUDA Forward Compatibility (cuda-compat-12-8) завершается с ошибкой 804.
TARGET_GPU_UUID=GPU-733ae7cc-c1bf-3352-42d5-ba2762470325

# Путь к директории с моделью на хосте
CODER390_MODELS_DIR=/root/model/coder390

# Основной файл модели NInfer V2 (символическая ссылка или имя .ninfer)
CODER390_MODEL_FILE=model_v100.ninfer

# Имя модели для OpenAI API / OmniRoute
CODER390_ALIAS=coder390-27b
CODER390_API_KEY=

# Контекст и KV кэш (NInfer V2)
CODER390_MAX_CONTEXT=204800
CODER390_KV_CAPACITY=auto
CODER390_MAX_CONCURRENCY=1
CODER390_KV_DTYPE=int8
CODER390_PREFILL_CHUNK=2048

# Слоты контекстного кэша (Device / Host State & Pinned Host KV)
CODER390_DEVICE_STATE_SLOTS=1
CODER390_HOST_STATE_SLOTS=8
CODER390_HOST_KV_MIB=8192

# Таймаут ожидания очереди/подготовки запроса (в мс): 20 минут = 1200000 мс (дефолт ninfer: 30000)
CODER390_PENDING_TIMEOUT_MS=1200000

# Спекулятивное декодирование MTP (согласно RUNBOOK: --spec mtp --draft-tokens 3)
CODER390_SPEC_BACKEND=mtp
CODER390_SPEC_DRAFT_TOKENS=3

# Режим рассуждений (thinking mode):
# В NInfer поддерживаются уровни: "xhigh", "low", "medium" (не "high"!)
CODER390_ENABLE_THINKING=true
CODER390_PRESERVE_THINKING=true
CODER390_REASONING_EFFORT=xhigh

# Параметры Vision
CODER390_ENABLE_VISION=true
CODER390_MEDIA_CACHE_MIB=512
CODER390_MEDIA_LIVE_MIB=1024
CODER390_MEDIA_PREPROCESS_THREADS=4

# Дополнительные аргументы запуска ninfer-serve
CODER390_EXTRA_ARGS=
