# ==============================================================================
# Переменные окружения для запуска HauhauCS Qwen3.8-27B-Aggressive (Tesla V100 32GB)
# Скопируйте в .env или экспортируйте перед запуском:
#   cp .env.qwen38.example .env.qwen38
#   docker compose --env-file .env.qwen38 -f docker-compose.qwen38.yml up -d
# ==============================================================================

# Привязка адреса хоста (0.0.0.0 для локальной сети LAN, 127.0.0.1 для локального доступа)
HOST_BIND_IP=0.0.0.0

# Порт сервиса на хосте (8081 чтобы не конфликтовать со стеком DSH / Laya на 8080)
QWEN_PORT=8081

# Путь к директории с моделями на хосте
QWEN_MODELS_DIR=/root/model/qwen3.8

# Основной файл модели (Оптимальный вариант по качеству и скорости: Q5_K_P ~18.83 GiB)
# Репозиторий: HauhauCS/Qwen3.8-27B-Uncensored-HauhauCS-Aggressive-MTP-GGUF
# Профиль Perfect (K_P): 5.92 BPW, матрицы внимания квантуются с повышенной точностью.
QWEN_MODEL_FILE=Qwen3.8-27B-Uncensored-HauhauCS-Aggressive-Q5_K_P.gguf

# HauhauCS FastMTP 32K Draft Sidecar (903 MB / 0.84 GiB)
# Обеспечивает ускорение TG до 3.02x относительно non-MTP без потери качества генерации.
QWEN_FASTMTP_FILE=Qwen3.8-27B-Uncensored-HauhauCS-Aggressive-FastMTP-32K.gguf
QWEN_ENABLE_FASTMTP=true
QWEN_SPEC_DRAFT_N_MAX=3

# Мультимодальный проектор зрения (Vision Projector mmproj)
# Файл: mmproj-Qwen3.8-27B-Uncensored-HauhauCS-Aggressive-BF16.gguf (931 MB)
# QWEN_NO_MMPROJ_OFFLOAD=true: Принудительно выгружает проектор в оперативную память CPU (RAM),
# сохраняя ~1.5–2.0 ГБ видеопамяти V100 под максимальный контекст и гарантируя защиту от OOM.
QWEN_MMPROJ_FILE=mmproj-Qwen3.8-27B-Uncensored-HauhauCS-Aggressive-BF16.gguf
QWEN_NO_MMPROJ_OFFLOAD=true
QWEN_CPU_THREADS=8

# Режим рассуждений модели (thinking mode)
# true: выдает reasoning_content (теги <think>)
# false: прямые ответы без цепочки рассуждений
QWEN_ENABLE_THINKING=true
QWEN_REASONING_EFFORT=xhigh

# Настройки контекста и GPU вычислений для 32GB VRAM:
# При квантовании KV-кэша F16 (-ctk f16 -ctv f16, 64 KiB/токен при 16 слоях внимания):
#   180000: Максимальный размер контекста (180K). KV-кэш ~11.25 GiB, оставляет ~0.6–0.8 GiB резерва до OOM.
#   160000: Консервативный безопасный режим (160K). KV-кэш ~10.00 GiB, оставляет ~2.0 GiB резерва.
# При квантовании KV-кэша Q8_0 (34 KiB/токен):
#   262144: Максимальное нативное окно (256K). Занимает 8.50 GiB KV, оставляет +1.60 GiB резерва.
QWEN_CTX_SIZE=180000
QWEN_N_GPU_LAYERS=999
QWEN_BATCH_SIZE=2048
QWEN_UBATCH_SIZE=512

# Формат KV-кэша:
#   f16   — Несжатая точность FP16 (64 KiB на токен). Контекст до 180 000 на 32GB VRAM.
#   q8_0  — Квантованный 8-битный кэш (34 KiB на токен). Позволяет до 262 144 (256K) токенов.
QWEN_CACHE_K=f16
QWEN_CACHE_V=f16

# Авторизация и имена модели для вызовов OpenAI API (задайте свой секретный ключ)
QWEN_API_KEY=
QWEN_ALIAS=qwen3.8-27b,qwen3.8,default

# Дополнительные аргументы (--mlock --no-mmap --cache-prompt-tokens --slots 1)
QWEN_EXTRA_ARGS=--mlock --no-mmap --cache-prompt-tokens --slots 1
