# ==============================================================================
# Переменные окружения для запуска Huihui-Qwen3.8-27B-abliterated (Tesla V100 32GB)
# Скопируйте в .env или экспортируйте перед запуском:
#   cp .env.qwen38.example .env.qwen38
#   docker compose --env-file .env.qwen38 -f docker-compose.qwen38.yml up -d
# ==============================================================================

# Привязка адреса хоста (0.0.0.0 для локальной сети LAN, 127.0.0.1 для локального доступа)
HOST_BIND_IP=0.0.0.0

# Порт сервиса на хосте (8081 чтобы не конфликтовать со стеком DSH / Laya на 8080)
QWEN_PORT=8081

# Путь к директории с моделями на хосте
QWEN_MODELS_DIR=/root/model/qwen3.8

# Основной файл модели (Рекомендованный для Tesla V100 32GB: Q5_K_L ~19.5GB)
# Обоснование из report.md:
#   - Volta (sm_70) не имеет аппаратной поддержки BF16.
#   - В сборке Q5_K_L аблейтированные тензоры лежат в Q8_0, а основные в Q5_K,
#     что обеспечивает максимальную скорость тензорных ядер и сохраняет 99.9% качества.
#   - Позволяет разместить всю модель и 262k KV-кэш в VRAM без оффлоада на CPU.
QWEN_MODEL_FILE=Huihui-Qwen3.8-27B-abliterated-Q5_K_L.gguf

# Мультимодальный проектор зрения (Vision Projector mmproj)
# Рекомендация report.md для Tesla V100 32GB:
#   - Файл: mmproj-model-bf16.gguf (~931 МБ)
#   - QWEN_NO_MMPROJ_OFFLOAD=true: Принудительно выгружает проектор в оперативную память CPU (RAM),
#     освобождая драгоценные ~1.5–2.2 ГБ HBM2 видеопамяти V100 под полный контекст 262k токенов.
#   - QWEN_CPU_THREADS: количество ядер CPU для предобработки изображений (например, 16)
QWEN_MMPROJ_FILE=mmproj-model-bf16.gguf
QWEN_NO_MMPROJ_OFFLOAD=true
QWEN_CPU_THREADS=16

# Режим рассуждений модели (thinking mode)
# true: выдает reasoning_content (теги <think>)
# false: прямые ответы без цепочки рассуждений
QWEN_ENABLE_THINKING=true

# Настройки контекста и GPU вычислений для 32GB VRAM (Нативный контекст 262 144 токенов)
QWEN_N_GPU_LAYERS=999
QWEN_CTX_SIZE=262144
QWEN_BATCH_SIZE=2048
QWEN_UBATCH_SIZE=512

# Формат KV-кэша для 262 144 токенов на Tesla V100 32GB:
#   q8_0  — РЕКОМЕНДУЕТСЯ: KV-кэш занимает ~8.1 ГБ (только 16 слоев из 64 требуют KV-кэша).
#           Вместе с моделью Q5_K_L (19.5 ГБ) и FlashAttention суммарно ~29.3 ГБ VRAM из 31.7 ГБ.
#           Запас свободного места ~2.4 ГБ исключает OOM при любых всплесках.
QWEN_CACHE_K=q8_0
QWEN_CACHE_V=q8_0

# Авторизация и имена модели для вызовов OpenAI API (задайте свой секретный ключ)
QWEN_API_KEY=
QWEN_ALIAS=qwen3.8-27b,qwen3.8,default

# Дополнительные аргументы (--mlock --no-mmap --cache-prompt-tokens --slots 1)
QWEN_EXTRA_ARGS=--mlock --no-mmap --cache-prompt-tokens --slots 1
