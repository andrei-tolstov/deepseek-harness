# ==============================================================================
# Переменные окружения для Ternary-Bonsai-2-27B-Uncensored-Heretic (Tesla V100 32GB)
# Скопируйте в .env или экспортируйте перед запуском:
#   cp .env.bonsai2.example .env.bonsai2
#   docker compose --env-file .env.bonsai2 -f docker-compose.bonsai2.yml up -d
# ==============================================================================

# Привязка адреса хоста (0.0.0.0 для локальной сети LAN, 127.0.0.1 для локального доступа)
HOST_BIND_IP=0.0.0.0

# Порт сервиса на хосте (8082, чтобы не конфликтовать с Qwen на 8081 и DSH на 8080)
BONSAI_PORT=8082

# Путь к директории с моделями на хосте
BONSAI_MODELS_DIR=/root/model/bonsai2

# Основной файл модели (Рекомендованный для максимального качества: PQ2_0 ~7.21GB)
# Обоснование из report-ternary-bonsai.md:
#   - Тернарные веса (1.58/1.72 бит) сжаты с 54 ГБ до 7.2 ГБ.
#   - Формат PQ2_0 обеспечивает максимальную стабильность активаций и 98.2% качества Qwen3.8.
#   - За счет компактности весов освобождается VRAM для эталонного несжатого FP16 KV-кэша!
BONSAI_MODEL_FILE=Ternary-Bonsai-2-27B-Uncensored-Heretic-PQ2_0.gguf

# Мультимодальный проектор зрения (Vision Projector mmproj)
# Рекомендация report-ternary-bonsai.md:
#   - Файл: mmproj-BF16.gguf (~931 МБ)
#   - BONSAI_NO_MMPROJ_OFFLOAD=true: выгружает Vision Tower в оперативную память CPU (RAM),
#     освобождая драгоценные ~1.5–2.2 ГБ HBM2 видеопамяти V100.
#   - BONSAI_CPU_THREADS: количество ядер CPU для предобработки изображений (например, 16)
BONSAI_MMPROJ_FILE=mmproj-BF16.gguf
BONSAI_NO_MMPROJ_OFFLOAD=true
BONSAI_CPU_THREADS=16

# Настройки контекста и GPU вычислений (Нативный контекст 262 144 токенов)
BONSAI_N_GPU_LAYERS=999
BONSAI_CTX_SIZE=262144
BONSAI_BATCH_SIZE=2048
BONSAI_UBATCH_SIZE=512

# Формат KV-кэша на Tesla V100 32GB:
#   f16  — РЕКОМЕНДУЕТСЯ: KV-кэш на 250k токенов занимает ~15.3 ГБ.
#          Вместе с весами модели PQ2_0 (7.2 ГБ) суммарно всего ~24.3 ГБ VRAM из 31.7 ГБ.
#          Остается огромный запас ~7.4 ГБ свободной VRAM!
#          Это дает 100% неискаженную точность внимания по всей глубине контекста.
BONSAI_CACHE_K=f16
BONSAI_CACHE_V=f16

# Режим рассуждений и сэмплирование (по рекомендациям разработчиков PrismML / Bonsai)
# Тернарные веса требуют температуры 1.0 (или 0.8-1.0) и связки top-p 0.95 / top-k 20 / min-p 0.05
BONSAI_REASONING_EFFORT=medium
BONSAI_TEMP=1.0
BONSAI_TOP_P=0.95
BONSAI_TOP_K=20
BONSAI_MIN_P=0.05

# Авторизация и имена модели для вызовов OpenAI API (задайте свой секретный ключ)
BONSAI_API_KEY=
BONSAI_ALIAS=bonsai2-27b,bonsai2,default

# Дополнительные аргументы (--mlock --no-mmap --cache-prompt-tokens --slots 1)
BONSAI_EXTRA_ARGS=--mlock --no-mmap --cache-prompt-tokens --slots 1
