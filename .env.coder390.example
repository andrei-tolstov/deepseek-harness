# ==============================================================================
# Переменные окружения для запуска nerkyor Qwen3.8-27B-Coder390-EfficientThink
# Специализированная конфигурация под NVIDIA Tesla V100 32GB (sm_70)
#
# Скопируйте в .env или используйте напрямую с docker compose:
#   cp .env.coder390.example .env.coder390
#   docker compose --env-file .env.coder390 -f docker-compose.coder390.yml up -d
# ==============================================================================

# Привязка адреса хоста (0.0.0.0 для локальной сети LAN, 127.0.0.1 для локального доступа)
HOST_BIND_IP=0.0.0.0

# Порт сервиса на хосте (8084 чтобы не конфликтовать с Laya 8080, Qwen 8081, Bonsai 8082, Fable 8083)
CODER390_PORT=8084

# Идентификатор GPU для изоляции (Tesla V100 32GB) во избежание сбоя CUDA Forward Compatibility
TARGET_GPU_UUID=GPU-733ae7cc-c1bf-3352-42d5-ba2762470325

# Путь к директории с моделью на хосте
CODER390_MODELS_DIR=/root/model/coder390

# Основной файл модели (Рекомендованный баланс качества и скорости на 32GB VRAM: Q4LynnStyle-MTP ~18.27 GiB)
# Репозиторий: nerkyor/Qwen3.8-27B-Coder390-EfficientThink-Opus5.5-GPT6Astra-Grok4.7-DSV4Pro-K3-SFT-RLOO-MTP-DFlash2
# Директория на HF: GGUF/
# Альтернативы:
#   Qwen3.8-27B-Coder390-EfficientThink-Q4LynnStyle-MTP.gguf (~18.27 GiB - Рекомендуется)
#   Qwen3.8-27B-Coder390-EfficientThink-Q4LynnStyle-Q8MTP.gguf (~18.47 GiB)
#   Qwen3.8-27B-Coder390-EfficientThink-Q3LynnStyle-MTP.gguf (~16.11 GiB)
CODER390_MODEL_FILE=Qwen3.8-27B-Coder390-EfficientThink-Q4LynnStyle-MTP.gguf

# Мультимодальный проектор зрения (Vision Projector mmproj)
# Файл: mmproj-Qwen3.8-27B-Q8_0.gguf (~629 MB)
# CODER390_NO_MMPROJ_OFFLOAD=true: выгружает проектор зрения в оперативную память хоста (CPU RAM),
# сохраняя ~1.5–2.0 ГБ видеопамяти V100 для максимального контекста без риска OOM.
CODER390_MMPROJ_FILE=mmproj-Qwen3.8-27B-Q8_0.gguf
CODER390_NO_MMPROJ_OFFLOAD=true
CODER390_CPU_THREADS=16

# Спекулятивное декодирование MTP:
# Модели LynnStyle-MTP содержат встроенный NextN head.
# Дополнительно доступен опциональный внешний сайдкар mtp-Qwen3.8-27B-Coder390-EfficientThink-Q8_0.gguf (~3.16 GB).
CODER390_ENABLE_MTP=true
CODER390_DRAFT_MTP_FILE=mtp-Qwen3.8-27B-Coder390-EfficientThink-Q8_0.gguf
CODER390_SPEC_DRAFT_N_MAX=3

# Режим рассуждений модели (thinking mode)
# Архитектура EfficientThink обучена с помощью RLOO и устраняет паразитные зацикливания
# (проблема 94K токенов и фразы "Wait, actually..."), гарантируя быстрый и надежный вывод кода.
CODER390_ENABLE_THINKING=true
CODER390_REASONING_EFFORT=high

# Настройки контекста и GPU вычислений для 32GB VRAM:
# При квантовании KV-кэша F16 (-ctk f16 -ctv f16, 64 KiB/токен):
#   180000: Безопасный максимум (180K). KV-кэш ~11.25 GiB. Суммарно с моделью 18.27 + 11.25 = ~29.5 GiB (запас ~2.5 GiB).
# При квантовании KV-кэша Q8_0 (-ctk q8_0 -ctv q8_0, 34 KiB/токен):
#   262144: Полное нативное окно (256K). Занимает ~8.5 GiB KV. Суммарно ~26.8 GiB (запас ~5.2 GiB).
CODER390_CTX_SIZE=180000
CODER390_N_GPU_LAYERS=999
CODER390_BATCH_SIZE=4096
CODER390_UBATCH_SIZE=1024

# Формат KV-кэша:
#   f16   — Несжатая точность FP16 (64 KiB на токен). Рекомендуется при контексте до 180 000.
#   q8_0  — 8-битный квантованный кэш (34 KiB на токен). Позволяет полный нативный контекст 262 144.
CODER390_CACHE_K=f16
CODER390_CACHE_V=f16

# Сэмплирование (для Coder390 / Автономных агентов кодинга):
# Рекомендуется строгая температура 0.6–0.7 для надежной логики и генерации кода, top-p 0.95, top-k 20, min-p 0.05.
# ВНИМАНИЕ: При использовании MTP параметр repeat_penalty должен быть строго 1.0!
CODER390_TEMP=0.65
CODER390_TOP_P=0.95
CODER390_TOP_K=20
CODER390_MIN_P=0.05
CODER390_REPEAT_PENALTY=1.0

# Авторизация и имена модели для вызовов OpenAI API
CODER390_API_KEY=
CODER390_ALIAS=coder390-27b,coder390,qwen3.8-coder390,default

# Дополнительные системные аргументы (--load-mode auto --slots 1)
CODER390_EXTRA_ARGS=--load-mode auto --slots 1
