[Unit]
Description=Set NVIDIA Tesla V100 Initial Power Limit on System Boot
After=nvidia-persistenced.service systemd-modules-load.service
Wants=nvidia-persistenced.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/nvidia-power-scheduler.sh auto
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
